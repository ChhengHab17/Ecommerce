<html>
  <head>
    <title>User Activation</title>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style type="text/css">
      body {
        margin: 0;
        padding: 0;
        min-width: 100%;
        font-family: Arial, sans-serif;
        font-size: 16px;
        line-height: 1.5;
        background-color: #f4f4f4;
        color: #222222;
      }
      a {
        color: #000;
        text-decoration: none;
      }
      h1 {
        font-size: 24px;
        font-weight: bold;
        line-height: 1.2;
        margin: 0 0 0 15px;
        text-align: center;
      }
      p {
        margin: 0 0 0 24px;
      }
      table td {
        vertical-align: top;
      }
      .email-wrapper {
        max-width: 600px;
        margin: 0 auto;
      }
      .email-header {
        background-color: rgb(41, 80, 255);
        padding: 24px;
        color: #fff;
      }
      .email-body {
        background-color: #ffffff;
        padding: 24px;
      }
      .email-footer {
        background-color: #f6f6f6;
        padding: 24px;
      }
      .button {
        display: inline-block;
        background-color: rgb(41, 80, 255);
        color: #ffffff;
        font-size: 16px;
        text-align: center;
        padding: 12px 24px;
        border-radius: 4px;
        text-decoration: none;
        font-weight: bold;
      }
    </style>
  </head>
  <body>
    <div class="email-wrapper">
      <div class="email-header">
        <h1>Welcome to the shop</h1>
      </div>
      <div class="email-body">
        <p>Hello <%= name %>,</p>
        <p>
          Thank you for registering with us! Please click the button below to
          activate your account:
        </p>
        <h2><%= otp %></h2>
        <p>Please enter this code to activate your account in 5 minutes</p>
      </div>
      <div class="email-footer">
        <p>If you have any questions, please contact our support team.</p>
      </div>
    </div>
  </body>
</html>
